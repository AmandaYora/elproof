{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "e2e": "playwright test -c e2e/playwright.config.ts --project=desktop --project=mobile --project=behavior --project=mutating",
    "e2e:update": "playwright test -c e2e/playwright.config.ts --update-snapshots --project=desktop --project=mobile",
    "e2e:stack": "tsx e2e/scripts/stack.ts up",
    "e2e:down": "tsx e2e/scripts/stack.ts down",
    "check:terms": "node scripts/check-ui-terms.mjs",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "e2e:perf": "playwright test -c e2e/playwright.config.ts --project=baseline"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@svar-ui/react-gantt": "^2.7.1",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^0.475.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.0.0",
    "tsx": "4.23.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
